{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-akmt",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b194f242-b129-431e-9b24-7fa7f14ad71e","database_name": "web-app-akmt" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "37021e17307340e3be12f3b0b1092529" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
